{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["ES2017", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"jsx": "react-jsx",
		"strict": true,
		"moduleResolution": "node",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": "./src"
	},
	"include": ["src"]
}
